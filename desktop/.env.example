# Copy to .env.
# Orion: Gemini drives the desktop (computer use); Gemini also captions screen memory and finds
# AI snap targets. Needs both keys.
GEMINI_API_KEY=
# ElevenLabs Scribe turns your Orion command into text.
ELEVENLABS_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING=low        low ≈ 5 s a step; medium/high think longer
# MAX_STEPS=30
# SAFE_MODE=1   Orion asks before risky actions (answer with OK / Cancel on the phone)
# ELEVENLABS_STT_MODEL=scribe_v2
# STT_LANGUAGE=en

# Orion's voice (ElevenLabs TTS). Default voice: George.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# TTS=0                      Orion stays silent
# WAKE=0                     don't listen for "Hey Orion" at start (offline Vosk; needs npm run setup:keys)

# Backboard (app.backboard.io): Orion's long-term memory of you, across sessions.
BACKBOARD_API_KEY=

# Screen memory (server/memory/): Orion remembers what was on screen. Gemini captions kept frames
# (they go to Google); Ollama embeds them locally (`ollama pull embeddinggemma`); captions,
# embeddings and the action log live in Tiger Cloud (screenshots stay on this laptop).
TIGER_DATABASE_URL=
# MEMORY=1                   record from server start (otherwise: the control page's button)
# MEMORY_INTERVAL_S=10
# MEMORY_DIFF_THRESHOLD=4    mean per-pixel change (0-255) on a 32x18 thumbnail before a frame counts as new
# MEMORY_PRIVATE_TITLES="password|bitwarden|1password|keepass|incognito|private browsing|bank|discord|slack|signal|whatsapp|messenger|telegram|\.env\b|secret|credential|api key"
# EMBED_MODEL=embeddinggemma
# OLLAMA_URL=http://127.0.0.1:11434
