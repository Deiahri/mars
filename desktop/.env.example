# Copy to .env.
# Orion: Claude drives the desktop. Needs both keys.
ANTHROPIC_API_KEY=
# ElevenLabs Scribe turns your Orion command into text.
ELEVENLABS_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low
# MAX_STEPS=30
# SAFE_MODE=1   Orion asks before risky actions (answer with OK / Cancel on the phone)
# ELEVENLABS_STT_MODEL=scribe_v2
# STT_LANGUAGE=en

# Screen memory (server/memory/): Orion remembers what was on screen. Haiku captions kept frames
# (they go to Anthropic); Ollama embeds them locally (`ollama pull embeddinggemma`).
# MEMORY=1                   record from server start (otherwise: the control page's button)
# MEMORY_INTERVAL_S=10
# MEMORY_DIFF_THRESHOLD=4    mean per-pixel change (0-255) on a 32x18 thumbnail before a frame counts as new
# MEMORY_PRIVATE_TITLES="password|bitwarden|1password|keepass|incognito|private browsing|bank|discord|slack|signal|whatsapp|messenger|telegram"
# MEMORY_CAPTION_MODEL=claude-haiku-5-5
# EMBED_MODEL=embeddinggemma
# OLLAMA_URL=http://127.0.0.1:11434
